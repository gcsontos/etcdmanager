{
  "name": "etcd-manager",
  "version": "1.2.1",
  "description": "Multi-platform ETCD v3 client and GUI",
  "author": "Tamas Geschitz <tamas.geschitz@icellmobilsoft.hu>",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint --ext .js,.ts,.vue src",
    "lint:fix": "eslint --ext .js,.ts,.vue src --fix",
    "electron:serve": "vite",
    "electron:build": "vite build && electron-builder",
    "electron:build:linux": "vite build && electron-builder --linux AppImage tar.gz --x64",
    "electron:build:mac": "vite build && electron-builder --macos dmg --x64",
    "electron:build:win": "vite build && electron-builder --windows nsis --x64 --ia32",
    "electron:generate-icons": "electron-icon-builder --input=./public/icon.png --output=public --flatten",
    "electron:publish:linux": "vite build && electron-builder --linux AppImage tar.gz --x64 -p always",
    "electron:publish:mac": "vite build && electron-builder --macos dmg --x64 -p always",
    "electron:publish:win": "vite build && electron-builder --windows nsis --x64 --ia32 -p always",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "prepare": "husky"
  },
  "main": "dist-electron/background.js",
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13",
    "@trodi/electron-splashscreen": "^1.0.0",
    "core-js": "^3.39.0",
    "electron-updater": "^6.3.0",
    "etcd3": "^1.1.2",
    "list-to-tree": "^2.2.3",
    "lodash-es": "^4.17.21",
    "markdown": "^0.5.0",
    "marked": "^4.3.0",
    "moment": "^2.30.1",
    "mousetrap": "^1.6.5",
    "protobufjs": "^7.4.0",
    "uuid": "^11.0.0",
    "vue": "^2.7.16",
    "vue-class-component": "^7.2.6",
    "vue-i18n": "^8.28.2",
    "vue-localstorage": "^0.6.2",
    "vue-property-decorator": "^9.1.2",
    "vue-router": "^3.6.5",
    "vuelidate": "^0.7.7",
    "vuetify": "^1.5.24",
    "vuex": "^3.6.2",
    "webpack-proto-loader": "^0.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/lodash-es": "^4.17.12",
    "@types/marked": "^0.7.4",
    "@types/mousetrap": "^1.6.15",
    "@types/uuid": "^10.0.0",
    "@types/vuelidate": "^0.7.21",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue2": "^2.3.0",
    "@vue/eslint-config-typescript": "^11.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0",
    "electron-devtools-installer": "^4.0.0",
    "electron-icon-builder": "^2.0.1",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-vue": "^9.0.0",
    "husky": "^9.0.0",
    "playwright": "^1.48.0",
    "sass": "^1.80.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vue-template-compiler": "^2.7.16"
  },
  "bugs": {
    "url": "https://github.com/icellmobilsoft/etcdmanager/issues/new?assignees=&labels=&template=bug_report.md&title=%5BBUG%5D"
  },
  "collaborators": [
    "Tamas Geschitz <getamas@gmail.com>",
    "Jozsef Szalai",
    "David Onofer",
    "Gabor Nagy"
  ],
  "contributors": [
    "Tamas Geschitz <getamas@gmail.com>",
    "Jozsef Szalai",
    "David Onofer",
    "Daniel Rudolf",
    "Gabor Nagy"
  ],
  "engines": {
    "node": ">= 22.0.0"
  },
  "homepage": "https://etcdmanager.io",
  "keywords": [
    "etcd",
    "etcd3",
    "gui",
    "client",
    "admin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/icellmobilsoft/etcdmanager.git"
  },
  "title": "ETCD Manager"
}
